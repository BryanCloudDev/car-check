NODE_ENV=development
PORT=3001

# PostgreSQL (matches docker-compose.yml in this directory)
POSTGRES_USER=car_check
POSTGRES_PASSWORD=car_check
POSTGRES_DB=car_check
POSTGRES_PORT=5432

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"

# Auth — generate with: openssl rand -base64 64
JWT_SECRET=change-me-before-running
JWT_EXPIRATION=86400s

# AWS S3 — provisioned by infra/s3 (Terraform)
# Run: cd infra/s3 && terraform output -json  to get these values after apply
AWS_REGION=us-east-1
S3_BUCKET=car-check-media-development-<suffix>
AWS_ACCESS_KEY_ID=<from terraform output iam_access_key_id>
AWS_SECRET_ACCESS_KEY=<from terraform output -raw iam_secret_access_key>
