# Copy to terraform.tfvars and fill in values before running.
# terraform.tfvars is gitignored — never commit real credentials.

aws_region = "us-east-1"
project    = "car-check"
env        = "production"

allowed_origins = [
  "http://localhost:3000",
  "https://your-vercel-domain.vercel.app",  # replace with real prod URL
]
