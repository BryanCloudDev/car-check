{
  "name": "car-check",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "apps/backend/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored --config apps/backend/eslint.config.mjs"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored --config apps/web/eslint.config.mjs"
    ],
    "packages/**/*.{ts,tsx}": "prettier --write",
    "*.{js,mjs,cjs,json,md,css}": "prettier --write"
  }
}
