# ─────────────────────────────────────────────────────────────
# Variables de producción — referencia para configurar en cada
# plataforma. NUNCA commitear con valores reales.
# ─────────────────────────────────────────────────────────────

# ── Railway (backend) ─────────────────────────────────────────
# Railway inyecta DATABASE_URL y PORT automáticamente.
# Solo necesitas agregar manualmente:
NODE_ENV=production
JWT_SECRET=CHANGE_ME   # openssl rand -base64 64

# ── Vercel (frontend) ─────────────────────────────────────────
# Configurar en Vercel dashboard → Settings → Environment Variables
# API_URL debe apuntar al dominio público del backend en Railway
API_URL=https://tu-backend.up.railway.app
